# Production Workbench — never commit the virtualenv, caches, or the local DB.
.venv/
__pycache__/
*.pyc
.DS_Store
# Local run state only — anchored so it does NOT match example package data/ folders.
/data/
*.db
*.sqlite3
# Machine-local deployment configuration (e.g. the target-environments file). Named
# `local/` (not `config/`) to avoid any ambiguity with the config.py module. Kept
# SEPARATE from /data/ so resetting runtime state never deletes deployment config.
/local/
